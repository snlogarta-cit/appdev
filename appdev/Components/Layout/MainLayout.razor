@inherits LayoutComponentBase

<div class="nyan-app-container">
    <!-- Floating whimsical particles across screens -->
    <div class="floating-particle" style="top: 12%; left: 8%; font-size: 1.4rem;">✨</div>
    <div class="floating-particle" style="top: 20%; right: 11%; font-size: 1.5rem; animation-delay: 1.5s;">💖</div>
    <div class="floating-particle" style="top: 40%; right: 5%; font-size: 1.3rem; animation-delay: 0.8s;">💫</div>
    <div class="floating-particle" style="top: 60%; left: 5%; font-size: 1.4rem; animation-delay: 2s;">⭐</div>
    <div class="floating-particle" style="top: 75%; right: 8%; font-size: 1.6rem; animation-delay: 1.2s;">🌸</div>

    @Body
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
