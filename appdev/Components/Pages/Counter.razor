@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<div class="max-w-xl mx-auto py-10 px-6">
    <h1 class="text-3xl font-bold text-pink-400 mb-4">Counter</h1>

    <p role="status" class="text-lg text-purple-200 mb-6 font-medium">
        Current count: <span class="font-bold text-emerald-400 text-xl">@currentCount</span>
    </p>

    <button class="px-5 py-2.5 bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 active:scale-95 text-white font-semibold rounded-full shadow-lg shadow-pink-500/30 transition-all duration-200 cursor-pointer" @onclick="IncrementCount">
        ✨ Click me
    </button>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
